{
  "name": "site-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#utils/*": "./src/utils/*",
    "#components/*": "./src/components/*",
    "#ui/*": "./src/components/ui/*",
    "#lib/*": "./src/lib/*",
    "#hooks/*": "./src/hooks/*",
    "#episode-metadata": "./src/episode-metadata.json",
    "#rss-feed-data": "./src/rss-feed-data.json"
  },
  "scripts": {
    "cf:typegen": "wrangler types",
    "dev": "concurrently \"waku dev\" \"bun ./scripts/prebuild.tsx --watch\"",
    "new": "bun ./scripts/new-episode.ts",
    "prebuild": "bun ./scripts/prebuild.tsx",
    "build": "waku build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "start": "wrangler dev",
    "predeploy": "bun run build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@atcute/bluesky": "3.1.2",
    "@atcute/bluesky-richtext-segmenter": "2.0.3",
    "@atcute/client": "4.0.3",
    "@atcute/lexicons": "1.0.4",
    "@hamstack/bluesky-comments": "0.1.1",
    "@hamstack/bluesky-embed-rsc": "1.0.2",
    "@orama/orama": "3.1.18",
    "@radix-ui/react-aspect-ratio": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/typography": "0.5.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "estree-util-visit": "2.0.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "hls.js": "1.7.3",
    "hono": "4.13.13",
    "html-url-attributes": "3.0.1",
    "lucide-react": "0.514.0",
    "mdxlite": "1.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sval": "0.6.12",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "waku": "0.27.5",
    "wrangler": "4.147.0"
  },
  "devDependencies": {
    "@hiogawa/node-loader-cloudflare": "0.0.2",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@parcel/watcher": "2.6.0",
    "@shikijs/rehype": "2.4.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.13.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "9.1.2",
    "fast-glob": "3.3.3",
    "gray-matter": "4.0.3",
    "miniflare": "3.20250129.0",
    "oxfmt": "^0.72.0",
    "postcss": "8.5.29",
    "rehype-mdx-code-props": "3.0.1",
    "remark-flexible-markers": "1.3.6",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.2"
  },
  "resolutions": {
    "vite": "7.3.0"
  }
}
